{
  "name": "convertara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "start": "npm run start --workspace apps/api",
    "test": "npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api",
    "up": "docker compose up -d --build",
    "down": "docker compose down"
  }
}
