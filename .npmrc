# Build-time dependencies must survive the install.
#
# `tsc` needs typescript, @types/node and @types/pg, and `next build` needs
# typescript to read the `@/*` paths out of tsconfig.json - all devDependencies.
# npm drops devDependencies whenever NODE_ENV is exactly "production", which is
# how a host like Render is normally configured, and the build then fails with
# "Cannot find name 'process'" and a wall of missing-type errors that look like
# a code problem rather than a missing install.
#
# Setting this here keeps the install honest wherever it runs, so the deploy no
# longer depends on how the host happens to set NODE_ENV.
include=dev
