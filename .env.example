# ---------------------------------------------------------------------------
# Convertara configuration
#
# Everything here has a working default except SECRET_KEY. `npm run dev` needs
# none of it - the API falls back to in-memory metadata, local-disk storage and
# an in-process queue so it boots with nothing installed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=*

# --- required in production ------------------------------------------------
# Encrypts provider API keys at rest. Generate with: openssl rand -hex 32
# Changing it makes every stored key undecryptable.
SECRET_KEY=

# Honour the `x-owner-id` header for multi-tenancy. Off by default: with no auth
# proxy in front, a client-supplied header is a tenant switch, not an identity.
# Turn it on only when something upstream sets and validates it.
TRUST_OWNER_HEADER=false

# --- infrastructure (leave empty for the zero-infra dev fallbacks) ----------
# In production, missing DATABASE_URL/REDIS_URL is a boot failure rather than a
# silent fall back to in-memory state. Override only for a deliberately
# single-container, ephemeral deployment.
ALLOW_EPHEMERAL_STATE=false
# DATABASE_URL=postgres://convertara:convertara@localhost:5432/convertara
# REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=convertara
# S3_ACCESS_KEY_ID=convertara
# S3_SECRET_ACCESS_KEY=convertara-secret
# S3_FORCE_PATH_STYLE=true

# --- AI planner ------------------------------------------------------------
# auto   - rules first, model only when the request is genuinely ambiguous
# always - always ask the model
# never  - rules only; ambiguous requests are rejected with an explanation
AI_MODE=auto

# Optional server-wide default. Users can override it per account in Settings,
# and most deployments leave this empty and let people bring their own key.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_TIMEOUT_MS=30000

# Permit LLM endpoints on loopback and private ranges. Required for local Ollama
# or an internal gateway; leave false on any shared host, where it would let a
# user point the server at the cloud metadata endpoint.
LLM_ALLOW_PRIVATE_ENDPOINTS=false

# --- limits ----------------------------------------------------------------
MAX_UPLOAD_BYTES=209715200
MAX_FILES_PER_REQUEST=64
# Aggregate ceiling for one request. Per-file limits alone do not bound a
# request: 64 files just under the cap is 12.8GB.
MAX_REQUEST_BYTES=419430400
# Work under both thresholds runs inside the request; anything bigger is queued.
SYNC_MAX_BYTES=25165824
SYNC_MAX_COST=60
EXECUTION_TIMEOUT_MS=120000
ARTIFACT_TTL_SECONDS=86400
# Also caps the optimizer's per-file fan-out. Peak memory is roughly
# WORKER_CONCURRENCY x largest input x 3.
WORKER_CONCURRENCY=4

# --- archive safety --------------------------------------------------------
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_TOTAL_BYTES=1073741824
ARCHIVE_MAX_RATIO=120

# --- compose only ----------------------------------------------------------
# POSTGRES_PASSWORD=convertara
# API_PORT=4000
# WEB_PORT=3000
